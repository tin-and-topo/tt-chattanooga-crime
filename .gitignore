# GIS Data Files (Never commit large spatial binaries!)
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.gdb/
*.gpkg
*.tif
*.tiff
*.img
*.las
*.laz

# Ignore large GeoJSON/CSV files (uncomment if you want to block all of them)
# *.geojson
# *.csv

# Project Data (enforces README rules)
# Ignores contents of data folders. Add a .gitkeep file to an empty
# folder if you want to commit the directory structure.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python & Virtual Environments
venv/
.venv/
env/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.coverage

# Python Build Artifacts
dist/
build/
*.egg-info/

# Node.js
node_modules/

# Environment Variables (Keep secrets safe!)
.env
.env.*
.env.local

# IDE & Editor Config
.vscode/
.idea/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log